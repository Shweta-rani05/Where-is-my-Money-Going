# Server configuration
PORT=5000
NODE_ENV=development

# Database configuration
MONGO_URI=mongodb://localhost:27017/where_is_my_money_going

# Security
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d

# Cors Configuration
CORS_ORIGIN=http://localhost:5173

# AI Services (fill in the one you use)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# WIMG Analytics Microservice (FastAPI)
# Local dev: http://localhost:8000
# Production: set to your Render analytics service URL
ANALYTICS_URL=http://localhost:8000

# Resend Email Service (for Email Expense Reports)
RESEND_API_KEY=your_resend_api_key_here
EMAIL_FROM="Where Is My Money Going <onboarding@resend.dev>"
